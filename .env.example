# All of these are SERVER-SIDE ONLY. Never prefix a secret with VITE_.
# Set them in Vercel → Project → Settings → Environment Variables
# (Preview → test Sheet, Production → live Sheet). See docs/PROJECT_PLAN.md §6.

# Apps Script web app (church Google account)
GAS_URL=
GAS_SECRET=

# Gmail SMTP (church Gmail + app password)
SMTP_USER=
SMTP_PASS=
EMAIL_MODE=log          # log | smtp

# Called by the Apps Script retry trigger
RETRY_SECRET=

# Raffle draw page (M6)
DRAW_PASSPHRASE=

# Registration window, ISO 8601 with offset, e.g. 2026-10-13T08:00:00+01:00
REGISTRATION_OPENS_AT=
REGISTRATION_CLOSES_AT=
