# All of these are SERVER-SIDE ONLY. Never prefix a secret with VITE_.
# Set them in Vercel → Project → Settings → Environment Variables
# (Preview → TEST, Production → LIVE). See docs/PROJECT_PLAN.md §6.

# Supabase (Project Settings → API Keys). Use the SECRET key (sb_secret_…), never the publishable one.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
EVENT_SLUG=awakening-2026

# Gmail SMTP (church Gmail + app password)
SMTP_USER=
SMTP_PASS=
EMAIL_MODE=log          # log | smtp

# Shared with the Apps Script trigger that calls /api/email-retry
RETRY_SECRET=

# Raffle draw page (M6)
DRAW_PASSPHRASE=

# Registration window, ISO 8601 with offset, e.g. 2026-10-13T08:00:00+01:00 (M4)
REGISTRATION_OPENS_AT=
REGISTRATION_CLOSES_AT=
